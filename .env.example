# Required: generate a long random secret; keep it out of GitHub.
ENGINE_API_TOKEN=replace-with-a-long-random-secret

# URL reachable FROM the machine running this API.
# If running beside ComfyUI, the default is usually correct.
COMFYUI_URL=http://127.0.0.1:8188

# Copy workflow.json.example to workflow.json and adapt the checkpoint filename.
COMFYUI_WORKFLOW_PATH=workflow.json

# Maximum time to wait for one generation.
COMFYUI_TIMEOUT_SECONDS=180
