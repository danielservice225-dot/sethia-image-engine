# Required: generate a long random secret; keep it out of GitHub.
ENGINE_API_TOKEN=replace-with-a-long-random-secret

# Default hosted image provider. Availability, rate limits and terms may change.
IMAGE_PROVIDER=pollinations
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt

# Optional: use a separately hosted ComfyUI server instead.
# IMAGE_PROVIDER=comfyui
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=workflow.json
COMFYUI_TIMEOUT_SECONDS=180
